#!/usr/bin/env bash
# Fake gnosis_vpn-ctl for the offline vpn-drain-tour.sh suite: fixed 3-destination fixture (de1 and us1 routable, de1 ranks first on lower cached quick-probe RTT; fr1 not_routable, never connectable), driven by FAKE_CTL_* env vars, with cross-invocation state (connected id, balance call count) kept in $FAKE_CTL_STATE since each call is a separate process.
set -u

STATE="${FAKE_CTL_STATE:?FAKE_CTL_STATE must be set}"
mkdir -p "$STATE"
CONNECTED_FILE="$STATE/connected"
BALANCE_CALLS_FILE="$STATE/balance_calls"
EMPTY_AFTER="${FAKE_CTL_EMPTY_AFTER:-0}" # 0 = funding traffic always "good"

is_in_list() {
    local needle="$1" hay=" ${2:-} "
    [ "$hay" != "  " ] && case "$hay" in *" $needle "*) return 0 ;; esac
    return 1
}

args=()
skip_next=0
for a in "$@"; do
    if [ "$skip_next" -eq 1 ]; then
        skip_next=0
        continue
    fi
    case "$a" in
    -o) skip_next=1 ;;
    *) args+=("$a") ;;
    esac
done
cmd="${args[0]:-}"

status_json() {
    local connected="" connection='{"type":"disconnected"}'
    [ -f "$CONNECTED_FILE" ] && connected="$(cat "$CONNECTED_FILE")"
    [ -n "$connected" ] && connection="{\"type\":\"connected\",\"destination\":\"$connected\",\"since\":0,\"tunnel_ping_rtt\":null,\"stall\":null}"
    cat <<JSON
{"type":"status","data":{"run_mode":{"type":"running"},"destinations":[
  {"destination":{"id":"de1","meta":{},"address":"0xDE1"},
   "route_health":{"state":{"type":"routable"},"last_error":null,"walk":null,
     "quick_probe":{"type":"checked","checked_at":0,"versions":{"api":["v1"],"server":null},"api_version":"v1",
       "load":{"slots":{"total":10,"available":8,"connected":2},"load_avg":{"one":0.1,"five":0.1,"fifteen":0.1,"nproc":4}},
       "status_rtt":40}}},
  {"destination":{"id":"us1","meta":{},"address":"0xUS1"},
   "route_health":{"state":{"type":"routable"},"last_error":null,"walk":null,
     "quick_probe":{"type":"checked","checked_at":0,"versions":{"api":["v1"],"server":null},"api_version":"v1",
       "load":{"slots":{"total":5,"available":1,"connected":4},"load_avg":{"one":0.1,"five":0.1,"fifteen":0.1,"nproc":4}},
       "status_rtt":80}}},
  {"destination":{"id":"fr1","meta":{},"address":"0xFR1"},
   "route_health":{"state":{"type":"not_routable"},"last_error":null,"walk":null,"quick_probe":null}}
],"target":null,"connection":$connection,"disconnecting":[],"probe":null}}
JSON
}

balance_json() {
    local calls=0
    [ -f "$BALANCE_CALLS_FILE" ] && calls="$(cat "$BALANCE_CALLS_FILE")"
    calls=$((calls + 1))
    echo "$calls" >"$BALANCE_CALLS_FILE"
    local traffic="good"
    if [ "$EMPTY_AFTER" -gt 0 ] && [ "$calls" -ge "$EMPTY_AFTER" ]; then
        traffic="empty"
    fi
    cat <<JSON
{"type":"balance","data":{"type":"available","node":"1 xDai","safe":"1 wxHOPR","channels_out":[],
  "info":{"node_address":"0xNODE","node_peer_id":"12D3","safe_address":"0xSAFE"},
  "capacity_allocations":null,"ideal_balance":null,
  "funding_status":{"traffic":{"type":"$traffic"},"gas":{"type":"good"},"wxhopr_deficit":null,"xdai_deficit":null,"refill_shortfall":null}}}
JSON
}

case "$cmd" in
status)
    status_json
    exit 0
    ;;
balance)
    if [ "${FAKE_CTL_BALANCE_SILENT:-0}" -eq 1 ]; then
        exit 1
    fi
    if [ "${FAKE_CTL_WORKER_OFFLINE:-0}" -eq 1 ]; then
        echo '{"type":"worker_offline"}'
        exit 69
    fi
    balance_json
    exit 0
    ;;
connect)
    id="${args[1]:-}"
    if is_in_list "$id" "${FAKE_CTL_FAIL_CONNECT:-}"; then
        echo "UnableToConnect: no route to $id" >&2
        exit 1
    fi
    if is_in_list "$id" "${FAKE_CTL_STALL_CONNECT:-}"; then
        echo "Connecting to $id"
        exit 0
    fi
    echo "$id" >"$CONNECTED_FILE"
    echo "Connecting to $id"
    exit 0
    ;;
disconnect)
    rm -f "$CONNECTED_FILE"
    echo "Disconnected"
    exit 0
    ;;
*)
    echo "fake gnosis_vpn-ctl: unknown command '$cmd'" >&2
    exit 2
    ;;
esac
